# Copy to .env and fill in. .env is gitignored; keep it that way -- it holds an
# InfluxDB token and your stream keys, and on most SRT servers the stream key IS
# the credential.

# --- the ingest under test ---------------------------------------------------
PRIMARY_HOST=ingest.example.com
PRIMARY_PORT=8890

# Full stream IDs, used verbatim. The publish:/read: prefixes are MediaMTX's
# convention, not srtbench's -- use whatever your server expects.
#
# BOTH are required. srtbench publishes with the first and reads the same stream
# back with the second, which is what makes the score cover the round trip.
# Setting only one is refused rather than quietly falling back to a local
# loopback that would never touch your server.
#
# Use a key reserved for testing, not a production one: the continuous services
# hold this path open permanently.
PRIMARY_PUBLISH_STREAMID=publish:CHANGE-ME
PRIMARY_READ_STREAMID=read:CHANGE-ME

# --- a second ingest (docker compose --profile secondary up -d) ---------------
SECONDARY_HOST=
SECONDARY_PORT=8890
SECONDARY_PUBLISH_STREAMID=
SECONDARY_READ_STREAMID=

# --- where measurements go ---------------------------------------------------
INFLUX_URL=http://influxdb.example.com:8086
INFLUX_TOKEN=CHANGE-ME
INFLUX_ORG=CHANGE-ME
INFLUX_BUCKET=srtbench

# Optional CSV, usable INSTEAD of InfluxDB. Either a path under /out (written to
# ./out on the host) or "-" for stdout. Leave empty to use InfluxDB only.
CSV_PATH=

# --- what gets streamed ------------------------------------------------------
# PROFILE, SIZE and VCODEC must agree. srtbench refuses to start if they do not
# -- the coefficients are codec- and resolution-specific, so a mismatch produces
# a confident score computed against the wrong curve, and nothing downstream
# would ever reveal it. Run `srtbench profiles` to see what is available.
PROFILE=h264-1080p
SIZE=1920x1080
FPS=30
VCODEC=libx264
BITRATE_KBPS=4500

# Your server's SRT latency budget. This is the most consequential setting for
# what the score means: it decides how much loss ARQ can repair before SRT gives
# up and the loss becomes damage. Match what your encoders actually use.
SRT_LATENCY=3s

# --- periodic probe (docker compose --profile periodic up -d) ----------------
PROBE_SECONDS=120
PROBE_INTERVAL_SECONDS=900

# --- runtime -----------------------------------------------------------------
SRTBENCH_TAG=latest
SRTBENCH_CPUS=2.0
SRTBENCH_MEMORY=512m
